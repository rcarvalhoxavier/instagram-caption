{
  "name": "instagram-caption",
  "version": "0.1.0",
  "description": "Resolve the author and caption of a public Instagram post, with no credentials",
  "keywords": ["instagram", "caption", "embed", "oembed", "metadata", "scraper", "read-later"],
  "homepage": "https://github.com/rcarvalhoxavier/instagram-caption",
  "repository": { "type": "git", "url": "git+https://github.com/rcarvalhoxavier/instagram-caption.git" },
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=24" },
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "bin": { "instagram-caption": "./dist/bin.js" },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:package": "bash scripts/verify-package.sh",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": { "typescript": "^7.0.0", "@types/node": "^26.6.1" }
}
